{
  "task": "ULSIR"     //  
  , "model": "plain" // 
  , "gpu_ids": [0,1]  // 
  , "dist": true

  , "scale": 1      // 
  , "n_channels": 1  // For the LLSD dataset, the value is set to 1, while for the other datasets, it is set to 3.

  , "path": {
    "root": "new"            // 
    , "pretrained_netG":  null// path of pretrained model. 
    , "pretrained_netE":  null  // path of pretrained model
  }

  , "datasets": {
    "train": {
      "name": "train_dataset"        // 
      , "dataset_type": "sr"         // 
      , "dataroot_H":  ~ // path of H training dataset
      , "dataroot_L": ~ // replace your training dataset            

      , "H_size": 256                   // GT image crop size

      , "dataloader_shuffle": true
      , "dataloader_num_workers": 28
      , "dataloader_batch_size": 20 
    }
    , "test": {
      "name": "test_dataset"         // 
      , "dataset_type": "sr"         // 
      , "dataroot_H":                // path of H testing dataset
      , "dataroot_L":                // path of L testing dataset

    }
  }

  , "netG": {
    "net_type": "darkcopy"
    , "init_type": "default"
  }

  , "train": {
    "G_lossfn_type": "l1"               // 
    , "G_lossfn_weight": 1.0            // default

    , "E_decay": 0.999                  // Exponential Moving Average for netG: set 0 to disable; default setting 0.999

    , "G_optimizer_type": "adam"        // fixed, adam is enough
    , "G_optimizer_lr": 2e-4          // learning rate
    , "G_optimizer_wd": 0               // weight decay, default 0
    , "G_optimizer_clipgrad": null      // unused
    , "G_optimizer_reuse": true         //

    , "G_scheduler_type": "MultiStepLR" // "MultiStepLR" is enough
    , "G_scheduler_milestones": [200, 400, 600, 800, 1000, 1200]
    , "G_scheduler_gamma": 0.5

    , "G_param_strict": true
    , "E_param_strict": true

  }
}
